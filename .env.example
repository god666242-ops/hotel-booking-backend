PORT=5000
NODE_ENV=production
DEV_FORCE_CUSTOM_DNS=true

CLOUDFLARE_TURNSTILE_SITE_KEY=<site key>
CLOUDFLARE_TURNSTILE_SECRET_KEY=<new secret>

SENTRY_DSN=<dsn>
OPS_ALERT_WEBHOOK_URL=<new slack webhook>
SUPER_ADMIN_ALERT_EMAIL=<email>
SUPER_ADMIN_EMAIL=<email>

ALLOWED_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com
SUPERADMIN_ALLOWED_ORIGINS=https://superadmin.yourdomain.com
CLIENT_BASE_URL=https://admin.yourdomain.com
ADMIN_BASE_URL=https://admin.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com

MONGODB_URI=<new connection string>
UPSTASH_REDIS_REST_URL=<url>
UPSTASH_REDIS_REST_TOKEN=<new token>

JWT_SECRET=<new random, 48+ chars>
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET_KEY=<new random 64 hex>

RESEND_API_KEY=<new key>
EMAIL_FROM=Reservations <bookings@mail.purebook.in>

# Master Razorpay: pay-at-hotel booking fees and commission payment links
MASTER_RAZORPAY_KEY_ID=rzp_live_...
MASTER_RAZORPAY_KEY_SECRET=<live secret>
MASTER_RAZORPAY_WEBHOOK_SECRET=<random 32+ chars>

RECONCILE_DISABLED=false
RECONCILE_LOOKBACK_HOURS=72

PLATFORM_LEGAL_NAME=PureBook (Prop. K Praveen Kumar)
PLATFORM_GSTIN=
PLATFORM_TERMS_URL=https://yourdomain.com/terms
PLATFORM_PRIVACY_URL=https://yourdomain.com/privacy

API_PUBLIC_URL above also feeds the calendar export links
ICAL_UID_DOMAIN=purebook.in
ICAL_SYNC_DISABLED=false
ICAL_ALLOW_HTTP=false

CLOUDINARY_CLOUD_NAME=<name>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<new secret>

COMMISSION_GST_PERCENT=0
COMMISSION_DUE_DAYS=7
COMMISSION_SUSPEND_AFTER_DAYS=10
COMMISSION_MIN_INVOICE_AMOUNT=100